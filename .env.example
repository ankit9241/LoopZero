# ==============================================================================
# LOOPZERO — Environment Configuration
# ==============================================================================

# Backend Port
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/loopzero?retryWrites=true&w=majority
# If omitted or unreachable, LOOPZERO automatically uses an isolated, in-memory local adapter.
MONGODB_URI=

# Local Ollama Inference Daemon
# Default endpoint where local Ollama runs:
OLLAMA_BASE_URL=http://localhost:11434

# Configured Local Gemma Model (e.g. gemma2:9b, gemma:2b, gemma2:2b)
OLLAMA_MODEL=gemma2:9b
